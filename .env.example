# Copy to .env.local (never committed) and fill in.

# Google Gemini (secret, server only). See docs/ai-providers.md.
# Used for every signed-in learner without their own key from Settings: your quota.
GOOGLE_GENERATIVE_AI_API_KEY=

# GitHub login (docs/auth.md). Locally: the "SkillForge (local)" OAuth app.
GITHUB_CLIENT_ID=
# secret, server only
GITHUB_CLIENT_SECRET=
# secret, server only, at least 32 characters; a different value on Vercel
SESSION_SECRET=

# Learning events from the Java backend on Cloud Run (docs/ticketing-backend.md).
# config: the api-gateway URL
TICKETING_API_URL=
# secret, server only: the gateway's API key
TICKETING_API_KEY=
