# Copy to .env.local (never committed) and fill in.

# Google Gemini: LOCAL DEVELOPMENT ONLY (secret, server only). See docs/ai-providers.md.
# Do not set it on Vercel: visitors bring their own key in Settings.
GOOGLE_GENERATIVE_AI_API_KEY=

# GitHub login (docs/auth.md). Locally: the "SkillForge (local)" OAuth app.
GITHUB_CLIENT_ID=
# secret, server only
GITHUB_CLIENT_SECRET=
# secret, server only, at least 32 characters; a different value on Vercel
SESSION_SECRET=
